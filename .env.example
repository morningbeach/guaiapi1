# ============================================
# 台灣公眾人物前科查詢機 - 環境變數設定
# ============================================
# 複製此檔案為 .env 並填入你的 API Key
#
#   cp .env.example .env
#
# ============================================

# OpenAI API Key（必填，用於 AI 風險評估）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 模型（選填，預設 gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key（用於精準深度 AI 分析）
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Anthropic 模型
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Flask 設定
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true
FLASK_PORT=5000

# 爬蟲設定
CRAWLER_DELAY=1.5
CRAWLER_MAX_RESULTS=30
